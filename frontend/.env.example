# Copy to .env.local and fill in what you need. Everything here is optional:
# with nothing set, the app runs on mock data and keeps trips in the browser.

# Where the FastAPI backend lives, e.g. https://liftoff-api.example.com
# Leave empty in development: Vite proxies /api to http://localhost:8000.
VITE_API_BASE=

# Appwrite sync for saved trips. Set all four to turn it on.
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_TABLE_ID=
